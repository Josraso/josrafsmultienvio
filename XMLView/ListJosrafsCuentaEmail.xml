<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : ListJosrafsCuentaEmail.xml
    Author     : Josra
    Description:
        Listado de cuentas de correo de salida.
-->
<view>
    <columns>
        <column name="id" display="none" order="100">
            <widget type="text" fieldname="id" onclick="EditJosrafsCuentaEmail"/>
        </column>
        <column name="name" order="110">
            <widget type="text" fieldname="nombre" onclick="EditJosrafsCuentaEmail"/>
        </column>
        <column name="email" order="120">
            <widget type="text" fieldname="email"/>
        </column>
        <column name="jmv-remitente" order="130">
            <widget type="text" fieldname="remitente"/>
        </column>
        <column name="printing-format" order="140">
            <widget type="select" fieldname="idformato">
                <values source="formatos_documentos" fieldcode="id" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="host" order="150">
            <widget type="text" fieldname="host"/>
        </column>
        <column name="default" order="160">
            <widget type="checkbox" fieldname="predeterminada"/>
        </column>
        <column name="jmv-orden" display="center" order="170">
            <widget type="number" fieldname="orden"/>
        </column>
        <column name="jmv-ultimo-test" order="180">
            <widget type="datetime" fieldname="testfecha"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="warning" fieldname="activa" title="jmv-desactivada">0</option>
            <option color="danger" fieldname="testok" title="mail-test-error">0</option>
        </row>
    </rows>
</view>
