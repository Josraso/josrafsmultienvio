<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : EditJosrafsCuentaEmail.xml
    Author     : Josra
    Description:
        Ficha de una cuenta de correo de salida.
-->
<view>
    <columns>
        <group name="email" icon="fa-solid fa-envelope" numcolumns="12">
            <column name="name" numcolumns="4" order="100">
                <widget type="text" fieldname="nombre" maxlength="50" required="true"/>
            </column>
            <column name="email" numcolumns="4" order="110">
                <widget type="text" fieldname="email" icon="fa-solid fa-envelope" required="true"/>
            </column>
            <column name="jmv-remitente" description="jmv-remitente-ayuda" numcolumns="4" order="120">
                <widget type="text" fieldname="remitente"/>
            </column>
            <column name="printing-format" description="jmv-formato-ayuda" titleurl="EditSettings?activetab=ListFormatoDocumento" numcolumns="6" order="130">
                <widget type="select" fieldname="idformato" icon="fa-solid fa-print" onclick="EditFormatoDocumento">
                    <values source="formatos_documentos" fieldcode="id" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="signature" numcolumns="12" order="140">
                <widget type="textarea" fieldname="firma"/>
            </column>
        </group>
        <group name="advanced" title="advanced" icon="fa-solid fa-server" numcolumns="12" valign="bottom">
            <column name="user" description="jmv-usuario-ayuda" numcolumns="3" order="100">
                <widget type="text" fieldname="usuario"/>
            </column>
            <column name="password" numcolumns="3" order="110">
                <widget type="password" fieldname="password" icon="fa-solid fa-key"/>
            </column>
            <column name="host" numcolumns="4" order="120">
                <widget type="text" fieldname="host" icon="fa-solid fa-server"/>
            </column>
            <column name="port" numcolumns="2" order="130">
                <widget type="number" fieldname="puerto" min="0"/>
            </column>
            <column name="enc" title="encrypt" numcolumns="3" order="140">
                <widget type="select" fieldname="enc" icon="fa-solid fa-shield-alt">
                    <values title="SSL">ssl</values>
                    <values title="TLS">tls</values>
                </widget>
            </column>
            <column name="mailer" numcolumns="3" order="150">
                <widget type="select" fieldname="mailer" required="true">
                    <values title="SMTP">smtp</values>
                    <values title="Mail">mail</values>
                    <values title="SendMail">sendmail</values>
                </widget>
            </column>
            <column name="authentication" numcolumns="3" order="160">
                <widget type="select" fieldname="authtype">
                    <values title="CRAM-MD5">CRAM-MD5</values>
                    <values title="LOGIN">LOGIN</values>
                    <values title="PLAIN">PLAIN</values>
                    <values title="XOAUTH2">XOAUTH2</values>
                </widget>
            </column>
            <column name="lowsecure" title="low-security" numcolumns="3" order="170">
                <widget type="checkbox" fieldname="lowsecure"/>
            </column>
        </group>
        <group name="copy" title="email-cc" icon="fa-solid fa-mail-bulk" numcolumns="12">
            <column name="reply" description="jmv-replyto-ayuda" numcolumns="4" order="100">
                <widget type="text" fieldname="replyto" icon="fa-solid fa-reply"/>
            </column>
            <column name="email-cc" description="accepts-emails-commas" numcolumns="4" order="110">
                <widget type="text" fieldname="emailcc" icon="fa-solid fa-envelope"/>
            </column>
            <column name="email-bcc" description="accepts-emails-commas" numcolumns="4" order="120">
                <widget type="text" fieldname="emailbcc" icon="fa-solid fa-envelope"/>
            </column>
        </group>
        <group name="jmv-control" title="jmv-control" icon="fa-solid fa-sliders" numcolumns="12">
            <column name="jmv-activa" numcolumns="3" order="100">
                <widget type="checkbox" fieldname="activa"/>
            </column>
            <column name="default" description="jmv-predeterminada-ayuda" numcolumns="3" order="110">
                <widget type="checkbox" fieldname="predeterminada"/>
            </column>
            <column name="jmv-orden" description="jmv-orden-ayuda" numcolumns="2" order="120">
                <widget type="number" fieldname="orden" min="0"/>
            </column>
            <column name="company" titleurl="ListEmpresa" numcolumns="4" order="130">
                <widget type="select" fieldname="idempresa" icon="fa-solid fa-building" onclick="EditEmpresa">
                    <values source="empresas" fieldcode="idempresa" fieldtitle="nombrecorto"/>
                </widget>
            </column>
            <column name="jmv-ultimo-test" numcolumns="4" order="140">
                <widget type="datetime" fieldname="testfecha" readonly="true"/>
            </column>
            <column name="jmv-test-ok" numcolumns="3" order="150">
                <widget type="checkbox" fieldname="testok" readonly="true"/>
            </column>
        </group>
    </columns>
</view>
